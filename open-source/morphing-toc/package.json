{
  "name": "morphing-toc",
  "version": "0.1.0",
  "description": "A React table of contents component that shows minimal lines and morphs into a full menu on hover",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "motion": ">=10.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "table-of-contents",
    "toc",
    "navigation",
    "animation",
    "framer-motion",
    "motion",
    "morphing"
  ],
  "author": "Antoine Pirard",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antoinepirard/morphing-toc"
  },
  "homepage": "https://antoinepirard.com/open-source/morphing-toc"
}
