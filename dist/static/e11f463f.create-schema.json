[
  {
    "fields": [
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "title",
        "type": "string"
      },
      {
        "options": {
          "source": "title",
          "maxLength": 96
        },
        "validation": [
          {
            "rules": [
              {
                "flag": "custom"
              },
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "URL-friendly identifier for the article",
        "name": "slug",
        "type": "slug"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "description": "Short description shown on the homepage",
        "name": "description",
        "type": "string"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              }
            ],
            "level": "error"
          }
        ],
        "name": "category",
        "type": "string",
        "title": "Category/Timeframe"
      },
      {
        "options": {
          "hotspot": true
        },
        "description": "Main image for the article",
        "name": "featuredImage",
        "type": "image"
      },
      {
        "description": "Full article content with rich text and images",
        "of": [
          {
            "marks": {
              "annotations": [
                {
                  "fields": [
                    {
                      "validation": [
                        {
                          "rules": [
                            {
                              "flag": "uri",
                              "constraint": {
                                "options": {
                                  "scheme": [
                                    "/^http$/",
                                    "/^https$/"
                                  ],
                                  "allowRelative": false,
                                  "relativeOnly": false,
                                  "allowCredentials": false
                                }
                              }
                            }
                          ],
                          "level": "error"
                        }
                      ],
                      "name": "href",
                      "type": "url",
                      "title": "URL"
                    }
                  ],
                  "name": "link",
                  "type": "object",
                  "title": "URL"
                }
              ],
              "decorators": [
                {
                  "value": "strong",
                  "title": "Strong"
                },
                {
                  "value": "em",
                  "title": "Emphasis"
                },
                {
                  "value": "code",
                  "title": "Code"
                }
              ]
            },
            "lists": [
              {
                "value": "bullet",
                "title": "Bulleted list"
              },
              {
                "value": "number",
                "title": "Numbered list"
              }
            ],
            "styles": [
              {
                "value": "normal",
                "title": "Normal"
              },
              {
                "value": "h1",
                "title": "H1"
              },
              {
                "value": "h2",
                "title": "H2"
              },
              {
                "value": "h3",
                "title": "H3"
              },
              {
                "value": "blockquote",
                "title": "Quote"
              }
            ],
            "of": [],
            "type": "block"
          },
          {
            "options": {
              "hotspot": true
            },
            "fields": [
              {
                "description": "Important for SEO and accessibility.",
                "name": "alt",
                "type": "string",
                "title": "Alternative text"
              },
              {
                "name": "caption",
                "type": "string"
              }
            ],
            "type": "image"
          }
        ],
        "name": "content",
        "type": "array",
        "title": "Article Content"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "uri",
                "constraint": {
                  "options": {
                    "scheme": [
                      "/^http$/",
                      "/^https$/"
                    ],
                    "allowRelative": false,
                    "relativeOnly": false,
                    "allowCredentials": false
                  }
                }
              }
            ],
            "level": "error"
          }
        ],
        "description": "Optional external link (if this redirects to external site instead of article page)",
        "name": "href",
        "type": "url",
        "title": "External Link URL"
      },
      {
        "validation": [
          {
            "rules": [
              {
                "flag": "presence",
                "constraint": "required"
              },
              {
                "flag": "min",
                "constraint": 0
              }
            ],
            "level": "error"
          }
        ],
        "description": "Lower numbers appear first",
        "name": "order",
        "type": "number",
        "title": "Display Order"
      },
      {
        "initialValue": true,
        "description": "Only published highlights will appear on the website",
        "name": "isPublished",
        "type": "boolean",
        "title": "Published"
      }
    ],
    "name": "highlight",
    "type": "document"
  }
